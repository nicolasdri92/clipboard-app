{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipboard",
  "version": "1.1.0",
  "identifier": "com.nicolasdri.clipboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipboard",
        "width": 900,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/imagenes/**",
          "$APPDATA/pendiente.png"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Textos e imágenes para copiar con un clic",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/etc/xdg/autostart/Clipboard.desktop": "linux/Clipboard-autostart.desktop"
        }
      }
    }
  }
}
